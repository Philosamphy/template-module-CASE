# Server
PORT=8000
# Comma-separated list of allowed browser origins for the React app.
CORS_ORIGINS=http://localhost:5173

# PostgreSQL — keep credentials here, never in source.
DATABASE_URL=postgresql://postgres:meowmeow@127.0.0.1:5432/template_module
# Apply idempotent migrations on boot (set to false to run `npm run migrate` yourself).
AUTO_MIGRATE=true

# Ollama (LangChain connects to this endpoint; the model must be pulled first:
# `ollama pull llama3`)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT_MS=90000

# Business-rule configuration
MAX_STEPS=20
SUPPORTED_ROLES=officer,approver,coordinator
SUPPORTED_NOTIFICATION_CHANNELS=email,telegram
